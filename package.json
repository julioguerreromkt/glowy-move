{
  "name": "glowy-move",
  "version": "1.0.0",
  "private": true,
  "description": "Glowy Move — coach de movimento da Glowy Life. Análise de exercício no dispositivo, biblioteca de exercícios e planejador semanal.",
  "scripts": {
    "prebuild": "node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx db/seed.ts",
    "fetch:model": "node scripts/fetch-model.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:static": "GLOWY_MOVE_STATIC=1 next build",
    "test:e2e": "node e2e/smoke.mjs",
    "test:static": "node e2e/static.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.39.0",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^30.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
